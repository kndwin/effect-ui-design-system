{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/vitest.config.ts",
    "packages/*/+rule/**/*.lint.ts",
    "packages/themes/*/src",
    "apps/*/src",
    "apps/*/*.build.ts",
    "apps/*/alchemy.run.ts",
    "apps/*/vitest.config.ts",
    "tools",
    "+rule/**/*.lint.ts",
    "oxlint.config.ts"
  ]
}
