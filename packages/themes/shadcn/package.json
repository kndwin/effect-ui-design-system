{
  "name": "@weft/theme-shadcn",
  "version": "0.0.0",
  "description": "A shadcn-style Weft theme, light and dark. weft theme shadcn copies it into your app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kndwin/weft.git",
    "directory": "packages/themes/shadcn"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/shadcn.theme.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/shadcn.theme.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@weft/components": "workspace:*",
    "@weft/design-system": "workspace:*"
  },
  "devDependencies": {
    "effect": "4.1.6"
  },
  "peerDependencies": {
    "effect": "^4.1.6"
  }
}
