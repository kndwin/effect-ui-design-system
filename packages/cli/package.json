{
  "name": "@weft/cli",
  "version": "0.0.0",
  "description": "weft install, weft add and weft theme, and WeftConfig for weft.config.ts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kndwin/weft.git",
    "directory": "packages/cli"
  },
  "bin": {
    "weft": "./bin/weft.js"
  },
  "files": [
    "bin/weft-node.js",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    "./add": "./src/feature/add/add.build.ts",
    "./templates": "./src/feature/install/install.constant.ts",
    "./WeftConfig": "./src/platform/config/weft-config.make.ts"
  },
  "publishConfig": {
    "bin": {
      "weft": "./bin/weft-node.js"
    },
    "exports": {
      "./add": "./dist/feature/add/add.build.js",
      "./templates": "./dist/feature/install/install.constant.js",
      "./WeftConfig": "./dist/platform/config/weft-config.make.js"
    }
  },
  "scripts": {
    "test": "bun --bun x vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.6",
    "@weft/components": "workspace:*",
    "@weft/design-system": "workspace:*",
    "@weft/theme-astryx": "workspace:*",
    "@weft/theme-shadcn": "workspace:*",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.6",
    "@types/node": "^22.20.7",
    "vitest": "5.1.1"
  }
}
