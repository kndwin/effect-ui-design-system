{
  "name": "acme-ds",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "lint": "oxlint --disable-nested-config",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm --filter @acme/components test",
    "docs": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "ci": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@effect/ui": "link:vendor/effect-ui/packages/ui",
    "@effect/ui-kit": "link:vendor/effect-ui/packages/ui-kit",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.20.0"
}
