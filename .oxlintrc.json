{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "ignorePatterns": ["vendor/**", "**/dist/**", "**/node_modules/**"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "import/no-unassigned-import": "off",
    // TypeScript already checks default imports, and ?source modules are virtual
    "import/default": "off",
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "acme/file-kind": "error",
    "acme/vanilla-imports": "error"
  },
  "jsPlugins": ["./tools/lint/plugin.ts"],
  "overrides": [
    {
      // data files: no side effects (see rule.pure.md)
      "files": ["**/*.pure.ts", "**/*.component.style.ts", "**/*.token.ts", "**/*.theme.ts"],
      "rules": { "acme/pure": "error" }
    },
    {
      // Component styles may only use tokens: no raw colours, lengths or durations.
      "files": ["**/*.component.style.ts"],
      "rules": { "acme/tokens-only": "error" }
    }
  ]
}
